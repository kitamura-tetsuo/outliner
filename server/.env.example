# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=7071
CORS_ORIGIN=http://localhost:7070,http://localhost:7080,http://localhost:5173

# Azure Fluid Relay Configuration
# Not required for local development

# Firebase Configuration
# Please place the firebase-adminsdk.json file in the server directory
FIREBASE_ADMIN_SDK_PATH=./firebase-adminsdk.json
# Public Firebase Web App configuration. Use these same values when building
# the client; the OAuth authorize page reads them directly instead of keeping
# a second OAUTH_FIREBASE_* copy.
# VITE_FIREBASE_API_KEY=your-web-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Firebase Emulator Configuration (for test environment)
# Do not set this in production environment
# FIREBASE_EMULATOR_HOST=localhost:4000
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Test User Configuration
TEST_USER_PASSWORD=password

# Trust proxy headers when behind a reverse proxy
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_HOPS=1

# OAuth/OIDC bridge for ChatGPT/MCP clients (see docs/client-features for the
# ftr-oauth-oidc-bridge feature doc). Required in production; auto-generates
# an ephemeral secret in dev/test.
# OAUTH_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
# OAUTH_ISSUER=https://outliner.example.com
# OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# OAUTH_AUTH_CODE_TTL_SECONDS=60
# Pre-registered clients, as an alternative/complement to dynamic client
# registration (POST /oauth/register):
# OAUTH_STATIC_CLIENTS=[{"client_id":"chatgpt","redirect_uris":["https://chat.openai.com/aip/.../oauth/callback"],"client_name":"ChatGPT"}]
