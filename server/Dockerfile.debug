FROM node:20-slim

# Build context is the repository ROOT so the shared schema (../shared) is
# available to the server build. See server/Dockerfile for details.
WORKDIR /usr/src/app

COPY shared/ ./shared/

COPY server/package*.json ./server/

RUN cd server && npm install

COPY server/ ./server/

RUN cd server && npm run build

# Install SSH server, sudo, and debug tools
RUN apt-get update && apt-get install -y openssh-server sudo curl vim net-tools wget && rm -rf /var/lib/apt/lists/*

# Add node user to sudoers
RUN echo "node ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

EXPOSE 1234 22

CMD ["/usr/src/app/server/start-debug.sh"]
