{
    "name": "fluid-outliner-server",
    "version": "1.0.0",
    "description": "Authentication server for Fluid Outliner app",
    "type": "module",
    "main": "dist/server/src/index.js",
    "scripts": {
        "prebuild": "rm -rf dist",
        "build": "tsc",
        "create-test-user": "node utils/create-test-user.js",
        "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/log-service.ts",
        "start": "node dist/server/src/index.js",
        "start:log-service": "node dist/server/src/log-service.js",
        "mcp:resolve:local": "tsx src/scripts/invoke-local-mcp.ts",
        "test": "bash ../scripts/run-server-tests.sh",
        "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:hocuspocus": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js",
        "test:emulator-wait": "mocha tests/log-service-emulator-wait.test.js --timeout 10000",
        "postinstall": "patch-package && (test -e ../shared/node_modules || ln -s ../server/node_modules ../shared/node_modules || true)",
        "postbuild": "ls -la dist",
        "test:unit": "npm run test:jest"
    },
    "overrides": {
        "yjs": "13.6.33"
    },
    "dependencies": {
        "@dotenvx/dotenvx": "^2.32.4",
        "@electric-sql/pglite": "^0.5.8",
        "@google-cloud/firestore": "^9.3.1",
        "@google-cloud/secret-manager": "^7.1.1",
        "@hocuspocus/extension-logger": "^4.7.0",
        "@hocuspocus/extension-sqlite": "^4.7.0",
        "@hocuspocus/server": "^4.2.0",
        "@modelcontextprotocol/node": "2.1.1",
        "@modelcontextprotocol/sdk": "1.32.1",
        "@modelcontextprotocol/server": "2.3.0",
        "@sentry/node": "^11.4.0",
        "better-sqlite3": "^13.0.3",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "find-process": "^2.1.1",
        "firebase-admin": "^14.5.0",
        "fs-extra": "^11.4.1",
        "helmet": "^8.3.0",
        "jose": "^6.2.12",
        "jsonwebtoken": "^9.0.3",
        "libpg-query": "18.1.5",
        "lru-cache": "^11.5.3",
        "luxon": "^3.7.2",
        "multer": "^2.4.0",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0",
        "rrule": "^2.8.1",
        "uuid": "^14.0.1",
        "ws": "^8.22.0",
        "yjs": "13.6.33",
        "yjs-orderedtree": "^1.0.1-beta.3",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@hocuspocus/provider": "^4.7.0",
        "@jest/globals": "^30.2.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/body-parser": "^1.19.6",
        "@types/chai": "^5.2.3",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/fs-extra": "^11.0.4",
        "@types/helmet": "^4.0.0",
        "@types/jest": "^30.0.0",
        "@types/luxon": "^3.7.6",
        "@types/mocha": "^10.0.10",
        "@types/multer": "^2.3.0",
        "@types/sinon": "^22.0.0",
        "@types/supertest": "^7.2.1",
        "@types/uuid": "^11.0.0",
        "@types/ws": "^8.18.2",
        "chai": "^6.3.0",
        "chalk": "^6.0.1",
        "dotenv": "^18.0.5",
        "inquirer": "^14.2.3",
        "jest": "^30.5.2",
        "mocha": "^12.0.3",
        "nodemon": "^3.1.14",
        "patch-package": "^8.0.1",
        "sinon": "^22.1.0",
        "supertest": "^7.3.1",
        "testdouble": "^3.22.0",
        "ts-jest": "^29.4.14",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "y-websocket": "^3.1.0"
    }
}
