{
  "name": "functions",
  "private": true,
  "description": "Firebase Cloud Functions for Outliner",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only auth,firestore,functions,hosting --project demo-test",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "build": "echo 'No build step required for JavaScript functions'",
    "debug": "firebase --debug emulators:start --inspect-functions=9229 --only auth,firestore,functions,hosting --project demo-test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "overrides": {
    "firebase-functions": {
      "firebase-admin": "$firebase-admin"
    },
    "firebase-functions-test": {
      "firebase-admin": "$firebase-admin"
    }
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.28.2",
    "@sentry/node": "^10.75.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "file-type": "^22.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axios": "^1.20.0",
    "eslint": "^10.10.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-functions-test": "^3.5.0",
    "jest": "^30.5.2"
  },
  "engines": {
    "node": "22"
  }
}
