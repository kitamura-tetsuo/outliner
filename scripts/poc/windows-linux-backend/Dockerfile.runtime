FROM node:22-trixie-slim
ARG APPLICATION_SHA
LABEL org.opencontainers.image.revision=$APPLICATION_SHA
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jre-headless python3 make g++ curl ca-certificates git procps \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# The context is git archive of the pinned application, extracted inside Ubuntu.
# No Windows dependency tree enters this image.
COPY . .
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci && npm --prefix client ci && npm --prefix server ci && npm --prefix functions ci \
    && ln -sfn ../client/node_modules shared/node_modules \
    && (cd server && npm run build) \
    && npm --prefix client run paraglide:compile \
    && npm install --prefix /opt/tools firebase-tools
CMD ["bash", "/harness/scripts/poc/windows-linux-backend/linux-services.sh"]
