{
    "indentWidth": 4,
    "lineWidth": 120,
    "newLineKind": "auto",
    "useTabs": false,
    "typescript": {
        "semiColons": "always",
        "quoteStyle": "preferDouble",
        "trailingCommas": "onlyMultiLine"
    },
    "json": {},
    "excludes": [
        "**/.git",
        "**/node_modules",
        "**/*-lock.json",
        "coverage/**",
        "lib/**",
        "built/**",
        "tests/**",
        "internal/**",
        "**/*.generated.*",
        "scripts/*.d.*",
        "**/_namespaces/**",
        "**/*.svelte",
        "**/*.html",
        "**/*.yaml",
        "**/*.yml"
    ],
    "toml": {},
    "dockerfile": {},
    "malva": {},
    "markup": {},
    "plugins": [
        "./node_modules/@dprint/typescript/plugin.wasm",
        "./node_modules/@dprint/json/plugin.wasm",
        "./node_modules/@dprint/markdown/plugin.wasm",
        "./node_modules/@dprint/toml/plugin.wasm",
        "./node_modules/@dprint/dockerfile/plugin.wasm",
        "./node_modules/dprint-plugin-malva/plugin.wasm",
        "./node_modules/dprint-plugin-markup/plugin.wasm",
        "./node_modules/dprint-plugin-yaml/plugin.wasm"
    ]
}
