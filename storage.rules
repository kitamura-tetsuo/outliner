rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    // Container-based attachments: /attachments/{containerId}/{itemId}/{fileName}
    // Access control based on Fluid Framework container permissions
    match /attachments/{containerId}/{itemId}/{fileName} {
      // Direct client access to Cloud Storage attachments is denied.
      // All attachment read/write traffic must go through the Firebase Functions endpoints
      // (uploadAttachment, listAttachments, deleteAttachment) which enforce access
      // securely via the Admin SDK and server/src/access-control.ts.
      allow read, write: if false;
    }
  }
}
