rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    // Container-based attachments: /attachments/{containerId}/{itemId}/{fileName}
    // Access control based on Fluid Framework container permissions
    match /attachments/{containerId}/{itemId}/{fileName} {
      allow read, write: if request.auth != null &&
        hasContainerAccess(request.auth.uid, containerId);
    }
  }
}

// Check if user has access to the container
// See server/src/access-control.ts for the authoritative access model.
// This function checks the projectUsers collection in Firestore as the single source of truth.
function hasContainerAccess(userId, containerId) {
  let projectUserDoc = /databases/$(database)/documents/projectUsers/$(containerId);
  return exists(projectUserDoc) &&
         userId in get(projectUserDoc).data.accessibleUserIds;
}
