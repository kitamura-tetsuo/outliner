rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    // Container-based attachments: /attachments/{containerId}/{itemId}/{fileName}
    // Direct client access is denied. All attachment traffic must go through
    // the Functions endpoints (uploadAttachment / listAttachments / deleteAttachment),
    // which enforce access via server/src/access-control.ts using the Admin SDK.
    match /attachments/{containerId}/{itemId}/{fileName} {
      allow read, write: if false;
    }
  }
}
